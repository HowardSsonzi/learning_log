[{"model": "learning_logs.topic", "pk": 1, "fields": {"text": "Chess", "date_added": "2026-04-21T16:47:21.492Z", "owner": 1}}, {"model": "learning_logs.topic", "pk": 2, "fields": {"text": "Rock Climbing", "date_added": "2026-04-21T16:48:31.295Z", "owner": 1}}, {"model": "learning_logs.topic", "pk": 3, "fields": {"text": "My E-commerce App", "date_added": "2026-05-02T17:52:55.585Z", "owner": 1}}, {"model": "learning_logs.topic", "pk": 4, "fields": {"text": "Alien Invasion", "date_added": "2026-05-02T17:58:15.146Z", "owner": 1}}, {"model": "learning_logs.topic", "pk": 5, "fields": {"text": "Random Information", "date_added": "2026-05-02T18:03:46.848Z", "owner": 1}}, {"model": "learning_logs.topic", "pk": 6, "fields": {"text": "The rat race.", "date_added": "2026-05-20T18:33:59.090Z", "owner": 2}}, {"model": "learning_logs.topic", "pk": 7, "fields": {"text": "Data science", "date_added": "2026-06-01T18:00:37.696Z", "owner": 1}}, {"model": "learning_logs.entry", "pk": 1, "fields": {"topic": 1, "text": "The opening is the first part of the game, roughly the first ten moves or so.  In the opening, it's a good idea to do three things-- bring out your bishops and knights, try to control the center of the board, and castle your king.\r\n\r\nOf course, these are just guidelines. It will be important to learn when to follow these guidelines and when to disregard these suggestions.", "date_added": "2026-04-21T18:00:24.952Z"}}, {"model": "learning_logs.entry", "pk": 2, "fields": {"topic": 1, "text": "In the opening phase of the game, it's important to bring out your bishops and knights. these pieces are powerful and maneuverable enough to play a significant role in the beginning moves of a game.", "date_added": "2026-04-21T18:03:51.306Z"}}, {"model": "learning_logs.entry", "pk": 3, "fields": {"topic": 2, "text": "One of the most important concepts in climbing is to keep your weight on your feet as much as possible.\r\nThere's a myth that climbers can hang all day on their arms. In reality, good climbers have practiced specific ways of keeping their weight over their feet whenever possible.", "date_added": "2026-04-21T18:07:10.336Z"}}, {"model": "learning_logs.entry", "pk": 4, "fields": {"topic": 1, "text": "You've got to love chess.", "date_added": "2026-04-22T16:48:29.919Z"}}, {"model": "learning_logs.entry", "pk": 5, "fields": {"topic": 1, "text": "The bishops and knights are good pieces to have out in the opening phase of the game. They're both powerful enough to be used in attacking your opponent, but not so powerful that you can't afford to lose them in an early trade off.", "date_added": "2026-05-06T17:51:06.237Z"}}, {"model": "learning_logs.entry", "pk": 6, "fields": {"topic": 6, "text": "This is the most dangerous race.", "date_added": "2026-05-20T18:40:44.365Z"}}, {"model": "admin.logentry", "pk": 1, "fields": {"action_time": "2026-04-21T16:47:21.497Z", "user": 1, "content_type": 7, "object_id": "1", "object_repr": "Chess", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 2, "fields": {"action_time": "2026-04-21T16:48:31.295Z", "user": 1, "content_type": 7, "object_id": "2", "object_repr": "Rock Climbing", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 3, "fields": {"action_time": "2026-04-21T18:00:24.964Z", "user": 1, "content_type": 8, "object_id": "1", "object_repr": "The opening is the first part of the game, roughly...", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 4, "fields": {"action_time": "2026-04-21T18:03:51.316Z", "user": 1, "content_type": 8, "object_id": "2", "object_repr": "In the opening phase of the game, it's important t...", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 5, "fields": {"action_time": "2026-04-21T18:07:10.340Z", "user": 1, "content_type": 8, "object_id": "3", "object_repr": "One of the most important concepts in climbing is ...", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 6, "fields": {"action_time": "2026-04-22T16:48:29.934Z", "user": 1, "content_type": 8, "object_id": "4", "object_repr": "You've got to love chess.", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "auth.user", "pk": 1, "fields": {"password": "pbkdf2_sha256$1200000$W69LE0NhDcdlqaXDxblntF$mWXb1TpIQXN75+wgv611pjYtSU6Twg8SMFgkOebq1qs=", "last_login": "2026-06-01T18:04:00.763Z", "is_superuser": true, "username": "howard_01", "first_name": "", "last_name": "", "email": "styleshoward12@gmail.com", "is_staff": true, "is_active": true, "date_joined": "2026-04-20T18:17:06.730Z", "groups": [], "user_permissions": []}}, {"model": "auth.user", "pk": 2, "fields": {"password": "pbkdf2_sha256$1200000$Lw9ZzxCvzmh0BYqSizjhHO$uhAmoIShHZrzaAZTIoZfrDvivAZms3csPyRF0A7/OIs=", "last_login": "2026-05-27T16:14:15.916Z", "is_superuser": false, "username": "Styles", "first_name": "", "last_name": "", "email": "", "is_staff": false, "is_active": true, "date_joined": "2026-05-18T15:43:44.962Z", "groups": [], "user_permissions": []}}, {"model": "sessions.session", "pk": "b9s6ci6ylysxuox7fethqqv0ddo6x509", "fields": {"session_data": ".eJxVjDsOwjAQBe_iGlnG-EtJnzNY610vDiBHipMKcXcSKQW0b2beWyRYl5rWXuY0krgKLU6_WwZ8lrYDekC7TxKntsxjlrsiD9rlMFF53Q7376BCr1uNjgGdyh5sZlDZeFbK6mIgquBAXwoSe4ZoDAadmUPQZywUN50skfh8AQ44OVI:1wPljr:83TzBVOcyCI_YRBvfX8Q76_Y_s1w3QLQcCypfkln8H8", "expire_date": "2026-06-03T18:33:51.165Z"}}, {"model": "sessions.session", "pk": "k0c74zdqwptg4rcf9lvd0tklqrzhcj56", "fields": {"session_data": ".eJxVjDsOwjAQBe_iGln-xD9Kes5g7dprHEC2FCcV4u4QKQW0b2bei0XY1hq3QUucMzszyU6_G0J6UNtBvkO7dZ56W5cZ-a7wgw5-7Zmel8P9O6gw6rcWSkxocYIgoCRntfMUfFIKrFXobQZPCtCk4nUoRpMAJxGMw6KlFMTeH94XN_Y:1wP0T6:aEst58fIvx_vZbWAeXD2OVYvFxqbAn36FYxvDyKTx3A", "expire_date": "2026-06-01T16:05:24.701Z"}}, {"model": "sessions.session", "pk": "nbal2xo93rboy2jxml9ujata3scj1kga", "fields": {"session_data": ".e